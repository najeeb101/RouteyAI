EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public Mapbox token (pk.…) — shipped inside the app, so never use a secret sk. token here
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-token
# Expo access token for eas-cli (expo.dev → Account settings → Access tokens). Never commit.
# EXPO_TOKEN=
