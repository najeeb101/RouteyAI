EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public Mapbox token (pk.…) — shipped inside the app, so never use a secret sk. token here
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-token
# Secret Mapbox token (sk.…, DOWNLOADS:READ scope) used only at build time by app.config.js.
# For EAS cloud builds: eas env:create --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN --visibility secret
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.your-secret-download-token
